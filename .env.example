# App
APP_PORT=3000
APP_DATABASE=mysql
APP_DOMAIN=arkadii.game.local
GRAFANA_DOMAIN=grafana.arkadii.game.local
PROMETHEUS_DOMAIN=prometheus.arkadii.game.local
HTTPS_PORT=443
CLIENT_API_URL=
CLIENT_WS_URL=

# MySQL
DATABASE_HOST=mysql
DATABASE_DB=t5c
DATABASE_USER=t5c
DATABASE_PASSWORD=t5c_password
MYSQL_ROOT_PASSWORD=t5c_root_password

# SQLite fallback, not used by docker-compose by default
DATABASE_PATH=./database.db

# Internal Grafana service, not published to the host
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
