# App
APP_PORT=3000
APP_DATABASE=mysql
APP_DOMAIN=arkadii.game.local
GRAFANA_DOMAIN=grafana.arkadii.game.local
PROMETHEUS_DOMAIN=prometheus.arkadii.game.local
HTTPS_PORT=443
CLIENT_API_URL=
CLIENT_WS_URL=
CLIENT_BASE_PATH=
CORS_ALLOWED_ORIGINS=https://arkadii.game.local,http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# MySQL
DATABASE_HOST=mysql
DATABASE_DB=arkadii_quest
DATABASE_USER=arkadii_quest
DATABASE_PASSWORD=arkadii_quest_password
MYSQL_ROOT_PASSWORD=arkadii_quest_root_password

# SQLite fallback, not used by docker-compose by default
DATABASE_PATH=./database.db

# Internal Grafana service, not published to the host
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
