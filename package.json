{
    "name": "arkadii-quest",
    "version": "0.5.0",
    "repository": {
        "url": "git+https://github.com/senior-13j/arkadii-quest-RPG.git"
    },
    "homepage": "https://arkadii.world/game/",
    "description": "Arkadii Quest is a bilingual multiplayer 3D browser RPG set in Arkadia.",
    "main": "./dist/client/index.html",
    "scripts": {
        "test": "tsx --test tests/*.test.ts",
        "client-dev": "webpack serve --open --config webpack.dev.js",
        "client-start": "webpack serve --open --config webpack.dev.js",
        "client-build": "webpack --config webpack.prod.js",
        "server-debug": "ts-node-dev --respawn --inspect --transpile-only src/server/index.ts",
        "server-dev": "ts-node-dev --respawn --inspect --transpile-only src/server/index.ts",
        "server-start": "ts-node --transpile-only src/server/index.ts",
        "server-build": "node scripts/clean-server-dist.mjs && tsc && node scripts/copy-public.mjs",
        "smoke:ws": "node --use-system-ca scripts/smoke-websocket.js",
        "check:public": "node scripts/check-public-readiness.mjs",
        "check:localization": "tsx scripts/check-localization.ts",
        "check:web-quality": "node scripts/check-web-quality.mjs",
        "test:e2e": "playwright test",
        "loadtest": "node scripts/run-loadtest.mjs"
    },
    "author": "Arkadii",
    "license": "MIT",
    "devDependencies": {
        "@babylonjs/addons": "8.28.3",
        "@babylonjs/gui-editor": "8.28.3",
        "@babylonjs/inspector": "8.28.3",
        "@babylonjs/materials": "8.28.3",
        "@colyseus/loadtest": "0.18.2",
        "@colyseus/monitor": "0.18.3",
        "@playwright/test": "^1.61.1",
        "@types/compression": "^1.8.1",
        "@types/node": "^20.12.12",
        "@types/react": "^18.3.2",
        "@types/react-dom": "^18.3.0",
        "copy-webpack-plugin": "^14.0.0",
        "dotenv-webpack": "^8.1.0",
        "sqlite3": "^6.0.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.23.1",
        "typescript": "^5.4.5",
        "webpack": "^5.92.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "6.0.0",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
        "@babylonjs/core": "8.28.3",
        "@babylonjs/gui": "8.28.3",
        "@babylonjs/loaders": "8.28.3",
        "@babylonjs/serializers": "8.28.3",
        "@colyseus/core": "0.18.10",
        "@colyseus/schema": "5.0.27",
        "@colyseus/sdk": "0.18.2",
        "@colyseus/ws-transport": "0.18.2",
        "axios": "^1.12.2",
        "babylonjs-gltf2interface": "8.28.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "fs-extra": "^11.2.0",
        "mysql2": "^3.10.2",
        "nanoid": "^3.0.0",
        "winston": "^3.13.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "msgpackr-extract@3.0.4": true,
        "sqlite3@6.0.1": true
    },
    "overrides": {
        "body-parser": "1.20.6",
        "qs": "6.16.0"
    },
    "browserslist": {
        "production": [
            "> 5%"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
