# Public deployment defaults for https://arkadii.world/game/
# Copy to .env.public and replace all CHANGE_ME values before running the public stack.

# Public domain and host bindings
APP_DOMAIN=arkadii.world
APP_BASE_PATH=/game
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# App
APP_PORT=3000
APP_DATABASE=mysql
CLIENT_API_URL=
CLIENT_WS_URL=
CLIENT_BASE_PATH=/game
CORS_ALLOWED_ORIGINS=https://arkadii.world,https://www.arkadii.world

# MySQL
DATABASE_HOST=mysql
DATABASE_DB=t5c
DATABASE_USER=t5c
DATABASE_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Internal Grafana service, not published by the public Caddy proxy
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
